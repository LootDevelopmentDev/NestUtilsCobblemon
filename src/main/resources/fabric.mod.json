{
	"schemaVersion": 1,
	"id": "cobblemonnestutilities",
	"version": "${version}",
	"name": "Cobblemon Nest Utilities",
	"description": "This is a utility mod for The Nest's Cobblemon Modpack!",
	"authors": [
		"Loot_"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/cobblemonnestutilities/icon.png",
	"environment": "*",
	"entrypoints": {
		"fabric-datagen": [
			"net.loot.cobblemonnestutilities.CobblemonNestUtilitiesDataGenerator"
		],
		"main": [
			"net.loot.cobblemonnestutilities.CobblemonNestUtilities"
		],
		"client": [
			"net.loot.cobblemonnestutilities.CobblemonNestUtilitiesClient"
		]
	},
	"mixins": [
		"cobblemonnestutilities.mixins.json",
		{
			"config": "cobblemonnestutilities.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"cobbreeding": "2.2.1",
		"mega_showdown": "1.7.2+1.7.3",
		"cobblemon": "1.7.3",
		"fabricloader": ">=0.18.4",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": "*"
	}
}